#!/usr/bin/env bash
set -euo pipefail

BASE="/usr/libexec/compresso"

usage() {
  cat <<'EOF'
CompressOS-HAL control (read-only)

Usage:
  compressoctl status
  compressoctl doctor
  compressoctl metrics
  compressoctl benchmark --profile PROFILE [--memory-mib N] [--hold-seconds N] [--output FILE]
  compressoctl help

This tool does not activate/deactivate swap or change profiles.
EOF
}

command_name="${1:-help}"
if (($#)); then shift; fi

case "$command_name" in
  status)
    exec python3 "$BASE/supervisor.py" --json "$@"
    ;;
  doctor)
    exec python3 "$BASE/supervisor.py" "$@"
    ;;
  metrics)
    exec python3 "$BASE/metrics.py" --stdout "$@"
    ;;
  benchmark)
    exec python3 "$BASE/benchmark.py" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Comando desconocido: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
