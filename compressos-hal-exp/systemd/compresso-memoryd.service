[Unit]
Description=CompressOS-HAL experimental memory configurator
After=local-fs.target systemd-modules-load.service
Before=swap.target
ConditionPathExists=/etc/compresso/memory.conf
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/libexec/compresso/memoryd.py --config /etc/compresso/memory.conf
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/sys/block /sys/module/zswap/parameters
CapabilityBoundingSet=CAP_SYS_ADMIN
[Install]
WantedBy=multi-user.target