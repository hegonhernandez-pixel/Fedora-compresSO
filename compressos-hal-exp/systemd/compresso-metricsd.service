[Unit]
Description=CompressOS-HAL read-only memory metrics snapshot
After=multi-user.target
[Service]
Type=oneshot
ExecStart=/usr/libexec/compresso/metrics.sh
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/compresso
[Install]
WantedBy=multi-user.target